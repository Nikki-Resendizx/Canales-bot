{
  "name": "canales-bot",
  "version": "1.0.0",
  "type": "module",
  "main": "src/bot.js",
  "scripts": {
    "start": "node src/bot.js",
    "check": "for file in src/*.js; do node --check \"$file\" || exit 1; done",
    "test": "node --test src/*.test.js",
    "validate": "npm run check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "telegraf": "^4.16.3",
    "dotenv": "^16.4.7"
  }
}
